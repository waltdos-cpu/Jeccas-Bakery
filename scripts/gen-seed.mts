// Regenerates supabase/seed.sql from src/lib/catalog.ts.
// Run: node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-seed.mts
import { writeFileSync } from "node:fs";
import { SEED_PRODUCTS, DEFAULT_SETTINGS } from "../src/lib/catalog.ts";

const q = (s: string) => `'${s.replaceAll("'", "''")}'`;

const rows = SEED_PRODUCTS.map(
  (p) =>
    `  (${[
      q(p.id),
      q(p.name_en),
      q(p.name_es),
      q(p.description_en),
      q(p.description_es),
      p.price_cents,
      p.pack_size,
      `${q(JSON.stringify(p.flavors))}::jsonb`,
      q(p.image),
      p.sort,
      p.active,
      p.sold_out,
    ].join(", ")})`,
);

const sql = `-- Generated by scripts/gen-seed.mts. Safe to re-run: existing rows are kept.
insert into products (id, name_en, name_es, description_en, description_es, price_cents, pack_size, flavors, image, sort, active, sold_out)
values
${rows.join(",\n")}
on conflict (id) do nothing;

insert into settings (id, data)
values (1, ${q(JSON.stringify(DEFAULT_SETTINGS))}::jsonb)
on conflict (id) do nothing;
`;

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log("wrote supabase/seed.sql");
